# Copy to .env (never commit real keys). See README for Streamlit secrets.
GROQ_API_KEY=your-groq-api-key-here
# Optional overrides (defaults shown):
# VERIS_GROQ_MODEL=openai/gpt-oss-20b
# VERIS_DISTANCE_THRESHOLD=1.5
# VERIS_MAX_UPLOAD_BYTES=10485760
# VERIS_SESSION_TTL_SECONDS=3600
# VERIS_LOG_LEVEL=INFO
# VERIS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# --- Phase 3: persistence + structured extraction (all optional, safe defaults) ---
# VERIS_DATA_DIR=data
# VERIS_SQLITE_PATH=data/veris.db
# VERIS_CHROMA_DIR=            # set to e.g. data/chroma to persist vectors
# VERIS_EXTRACTION_ENABLED=on  # set to off for RAG-only uploads
# VERIS_EXTRACTION_MAX_CHARS=12000
# VERIS_EXTRACTION_TIMEOUT_S=90
# VERIS_EXTRACTION_MAX_RETRIES=1
