+<script>
+const $=s=>document.querySelector(s),cv=$("#gl"),ts=$("#toast");let tm;
+function toast(m){ts.textContent=m;ts.classList.add("show");clearTimeout(tm);tm=setTimeout(()=>ts.classList.remove("show"),2200)}
+(function(){
+ const gl=cv.getContext("webgl");if(!gl)return;
+ const sh=(t,s)=>{const o=gl.createShader(t);gl.shaderSource(o,s);gl.compileShader(o);return o};
+ const pr=gl.createProgram();
+ gl.attachShader(pr,sh(gl.VERTEX_SHADER,"attribute vec2 a;void main(){gl_Position=vec4(a,0.,1.);}"));
