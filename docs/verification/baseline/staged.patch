diff --git a/frontend/reference/overview.html b/frontend/reference/overview.html
new file mode 100644
index 0000000..5662527
--- /dev/null
+++ b/frontend/reference/overview.html
@@ -0,0 +1,214 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
+<title>Veris � Overview</title>
+<style>
+:root{--text:#f2f0ff;--muted:#b4afe0;--border:rgba(150,125,255,.38);--violet:#8b5cf6;--cyan:#22d3ee;--green:#34d399;--amber:#f59e0b;
+box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:dark}
+html{scroll-padding-top:env(safe-area-inset-top,0px);min-height:100%}
+*{box-sizing:border-box}
+body{margin:0;min-height:100vh;color:var(--text);font-family:"Inter","Segoe UI",system-ui,sans-serif;
+ background:radial-gradient(50% 45% at 78% 15%,#5b2bd6,transparent 65%),radial-gradient(40% 40% at 5% 100%,#1d4ed8,transparent 65%),#05030f}
+#gl{position:fixed;inset:0;width:100%;height:100%;z-index:0}
+.app{position:relative;z-index:1;display:grid;grid-template-columns:104px 1fr;min-height:100vh}
+.side{border-right:1px solid rgba(150,125,255,.25);background:linear-gradient(180deg,rgba(8,5,32,.55),rgba(8,5,32,.25));backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);padding:16px 8px;display:flex;flex-direction:column;gap:6px}
+.logo{font-size:20px;font-weight:600;padding:2px 6px 18px;display:flex;gap:6px;align-items:center}
+.logo b{color:#a78bfa;font-style:italic;text-shadow:0 0 14px #8b5cf6}
+.nav{display:flex;align-items:center;gap:8px;padding:9px 8px;border-radius:9px;font-size:12px;color:var(--muted);border:1px solid transparent;cursor:pointer}
+.nav svg{width:15px;height:15px;flex:none}
+.nav:hover{color:#fff}
